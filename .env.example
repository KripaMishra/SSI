# Gemini API
GEMINI_API_KEY=

# ChromaDB Cloud (leave blank to use local PersistentClient fallback at .chroma/)
# Minimum: set CHROMA_API_KEY; Chroma resolves tenant/database from the key.
# Set CHROMA_TENANT and CHROMA_DATABASE explicitly if your key is scoped to multiple.
# For non-default regions, set CHROMA_CLOUD_HOST (e.g. europe-west1.gcp.trychroma.com)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=SSI
CHROMA_CLOUD_HOST=
# CHROMA_CLOUD_PORT=443

# PostgreSQL (leave blank to use local SQLite fallback at ssi.db)
POSTGRES_URL=

# Agent LLM backend — Command Code Provider API (OpenAI-compatible).
# Key: Studio -> API keys (https://commandcode.ai/studio). GOAT/Pro/Max/Team plans
# include API access; usage on those plans meters against their credits. Go has no
# API access. The same key authenticates the `cmd` CLI.
OPENAI_BASE_URL=https://api.commandcode.ai/provider/v1
OPENAI_API_KEY=
# Exact, namespaced model id (see docs/MODEL_BENCHMARK.md and docs/adr/008).
MODEL_NAME=deepseek/deepseek-v4-flash
# Must be one the chosen model advertises; deepseek-v4-flash supports "high" and "max".
AGENT_REASONING_EFFORT=high
# NOTE: pydantic-settings maps src/agent/config.py `model_name` to the MODEL_NAME env var;
# AGENT_MODEL is not consumed (see docs/MODEL_BENCHMARK.md).

# Redis (semantic cache + Dramatiq task store)
# REDIS_URL=rediss://default:...

# Dramatiq queue (see docker-compose.yml for the worker processes)
# Fallback order: QUEUE_REDIS_URL -> REDIS_URL -> redis://localhost:6379/0
# QUEUE_REDIS_URL=redis://localhost:6379/0
# QUEUE_NAME=asks
# TASK_TTL_SECONDS=3600

# API auth (shared-secret header auth for public deployments)
# Empty = disabled (local dev, no header required). Set to a strong random
# token in public deployments; callers must send it as `X-API-Key: <token>`.
API_AUTH_TOKEN=

# Cache settings
# CACHE_TTL_SECONDS=600
# CACHE_SIMILARITY_THRESHOLD=0.97
