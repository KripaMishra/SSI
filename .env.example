# Gemini API
GEMINI_API_KEY=

# ChromaDB Cloud (leave blank to use local PersistentClient fallback at .chroma/)
# Minimum: set CHROMA_API_KEY; Chroma resolves tenant/database from the key.
# Set CHROMA_TENANT and CHROMA_DATABASE explicitly if your key is scoped to multiple.
# For non-default regions, set CHROMA_CLOUD_HOST (e.g. europe-west1.gcp.trychroma.com)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=SSI
CHROMA_CLOUD_HOST=
# CHROMA_CLOUD_PORT=443

# PostgreSQL (leave blank to use local SQLite fallback at ssi.db)
POSTGRES_URL=

# Agent LLM backend (OpenAI-compatible, e.g. opencode-go)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=
MODEL_NAME=deepseek-v4-flash
AGENT_REASONING_EFFORT=medium
# NOTE: pydantic-settings maps src/agent/config.py `model_name` to the MODEL_NAME env var;
# AGENT_MODEL is not consumed (see docs/MODEL_BENCHMARK.md).

# Upstash Redis (used by semantic cache + QStash result storage)
# REDIS_URL=rediss://default:...

# QStash (used by /ask queue)
# QSTASH_URL=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_QUEUE_NAME=ssi-asks
# QSTASH_WEBHOOK_PATH=/webhook/process
# QSTASH_WEBHOOK_BASE_URL=https://your-public-domain.com
# QSTASH_POLL_INTERVAL=0.5
# QSTASH_JOB_TIMEOUT=180

# API auth (shared-secret header auth for public deployments)
# Empty = disabled (local dev, no header required). Set to a strong random
# token in public deployments; callers must send it as `X-API-Key: <token>`.
# /webhook/process is exempt — it verifies the QStash Upstash-Signature instead.
API_AUTH_TOKEN=

# Cache settings
# CACHE_TTL_SECONDS=600
# CACHE_SIMILARITY_THRESHOLD=0.97
