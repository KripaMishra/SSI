# Gemini API
GEMINI_API_KEY=

# ChromaDB Cloud (leave blank to use local PersistentClient fallback at .chroma/)
# Minimum: set CHROMA_API_KEY; Chroma resolves tenant/database from the key.
# Set CHROMA_TENANT and CHROMA_DATABASE explicitly if your key is scoped to multiple.
# For non-default regions, set CHROMA_CLOUD_HOST (e.g. europe-west1.gcp.trychroma.com)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=SSI
CHROMA_CLOUD_HOST=
# CHROMA_CLOUD_PORT=443

# PostgreSQL (leave blank to use local SQLite fallback at ssi.db)
POSTGRES_URL=

# Agent LLM backend (OpenAI-compatible, e.g. opencode-go)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o
AGENT_REASONING_EFFORT=medium
